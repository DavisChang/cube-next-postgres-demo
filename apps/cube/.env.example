# --- PostgreSQL (source) ---
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=localhost
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=analytics
CUBEJS_DB_USER=analytics
CUBEJS_DB_PASS=pass

# --- API & Security ---
CUBEJS_API_SECRET=dev_secret_change_me
CUBEJS_DEV_MODE=true

# --- Scheduled Refresh ---
CUBEJS_SCHEDULED_REFRESH_TIMER=true
CUBEJS_SCHEDULED_REFRESH_TIMEZ=Asia/Taipei
